[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

2d_physics/layer_1="Solid / Hitscan"
2d_physics/layer_2="Mouse Interaction"
2d_physics/layer_3="Body Barrier (no hitscan)"
2d_physics/layer_4="Vision Blocker"
2d_physics/layer_5="AI Sight Blocker"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/multi_bounce_occlusion/enabled=true
2d/shadow_atlas/size=4096
environment/defaults/default_clear_color=Color(0.007, 0.01, 0.014, 1)
